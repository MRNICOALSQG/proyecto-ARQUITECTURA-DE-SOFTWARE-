# Rin'ne - variables de entorno para Docker Compose (raiz del repositorio).
# Copia este archivo como .env y ajusta los valores:
#   cp .env.example .env
# El archivo .env NO debe versionarse.

# ---- PostgreSQL ----
POSTGRES_DB=rinne
POSTGRES_USER=rinne_user
# Obligatoria. Usa una contrasena propia y mantenla fuera de Git.
# Compose construye DATABASE_URL con este valor; si contiene caracteres
# especiales, codificalos para URL (por ejemplo @ -> %40, : -> %3A).
DB_PASSWORD=CAMBIAR_PASSWORD

# ---- API ----
# Secreto para firmar los JWT. Obligatorio, minimo 32 caracteres.
# Genera uno propio y no reutilices el valor de ejemplo.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=24h
# Origen permitido por CORS. La aplicacion se sirve en este mismo origen.
FRONTEND_URL=http://localhost:8080

# Limite por archivo de audio en bytes (52428800 = 50 MB).
MAX_FILE_SIZE=52428800

# Ajustes del pool de conexiones de PostgreSQL.
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# Opcional: version reportada por /api/health en builds locales.
# En produccion se usa la version horneada en la imagen publicada.
# APP_VERSION=local

# ---- Imagenes de produccion (compose.prod.yml) ----
# Etiqueta de las imagenes publicadas en GHCR. El pipeline debe publicarla.
TAG=latest
