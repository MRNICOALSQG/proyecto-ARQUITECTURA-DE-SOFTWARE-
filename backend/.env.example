# Rin'ne Backend - ejemplo de configuración
# Copia este archivo como backend/.env y ajusta los valores.
# El archivo backend/.env NO debe versionarse.

# Entorno de ejecución: development | test | production
NODE_ENV=development
# Versión reportada por /api/health. Docker o el pipeline pueden inyectarla.
APP_VERSION=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Conexión a PostgreSQL.
# Docker Compose publica el puerto 5433 en este proyecto:
#   postgresql://rinne_user:CAMBIAR_PASSWORD@localhost:5433/rinne
# Si usas un PostgreSQL local, ajusta host, puerto y credenciales.
DATABASE_URL=postgresql://rinne_user:CAMBIAR_PASSWORD@localhost:5433/rinne

# Secreto para firmar los tokens JWT.
# Obligatorio y de al menos 32 caracteres. No reutilices un valor de ejemplo.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_DE_AL_MENOS_32_CARACTERES
# Formato: 15m, 24h, 7d...
JWT_EXPIRES_IN=24h

# Directorio de subidas (relativo a backend/ o ruta absoluta).
UPLOAD_DIR=./uploads
# Tamaño máximo por archivo de audio, en bytes (52428800 = 50 MB).
MAX_FILE_SIZE=52428800

# Ajustes del pool de conexiones de PostgreSQL.
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# Solo para el runner de migraciones. Si se omite, `pnpm migrate` busca
# ../database/migrations a partir del directorio de trabajo.
# MIGRATIONS_DIR=../database/migrations
