{
  "name": "rinne-backend",
  "version": "1.0.0",
  "description": "Rin'ne Music Streaming Platform - Backend API",
  "main": "dist/server.js",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsc --declaration false --declarationMap false && node dist/migrations/cli.js",
    "test": "npm run test:build && node --test --test-concurrency=1 .test-dist/tests/**/*.test.js",
    "test:build": "node -e \"require('fs').rmSync('.test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "test:unit": "npm run test:build && node --test --test-concurrency=1 .test-dist/tests/unit/**/*.test.js",
    "test:integration": "npm run test:build && node --test --test-concurrency=1 .test-dist/tests/integration/**/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
