# Rin'ne Database - ejemplo de configuración de Docker Compose
# Copia este archivo como database/.env y ajusta los valores.
# El archivo database/.env NO debe versionarse.

POSTGRES_DB=rinne
POSTGRES_USER=rinne_user
# Obligatoria. Usa una contraseña propia y mantenla fuera de Git.
POSTGRES_PASSWORD=CAMBIAR_PASSWORD
# Puerto publicado en el host (el contenedor sigue usando 5432 internamente).
POSTGRES_PORT=5433
