# URL base de la API.
# Por defecto /api (mismo origen, usando el proxy de Vite en desarrollo).
# Puede ser una ruta relativa (/api) o una URL absoluta (https://api.ejemplo.com/api).
VITE_API_URL=/api

# Solo desarrollo: destino al que Vite reenvia /api y /uploads.
# No se expone al cliente ni se usa en el build de produccion.
DEV_API_TARGET=http://localhost:3001
