  rAuth --> cAuth
  rSongs --> cSongs
  rPref --> cPref
  rPlay --> cPlay
  rFav --> cFav
  rUpload --> cUpload
  cSongs --> uploads
  cUpload --> uploads

  cAuth --> sAuth
  cSongs --> sSongs
  cPref --> sPref
  cPlay --> sPlay
  cFav --> sFav

  sAuth --> repAuth
