  sPref --> repPref
  sPlay --> repPlay
  sFav --> repFav

  repAuth --> pool
  repSongs --> pool
  repPref --> pool
  repPlay --> pool
  repFav --> pool
  health --> pool
  pool --> pg

  static --> disk
  uploads --> disk
  cSongs -->|"createReadStream / pipeline (Range)"| disk
  sSongs -->|"stat del archivo"| disk

  sAuth --> authMw
  sAuth --> sanitize
  sSongs --> sanitize
  sSongs --> httpErr
  sPlay --> sanitize
  sPlay --> httpErr
